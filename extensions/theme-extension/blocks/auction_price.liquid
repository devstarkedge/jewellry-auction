{% comment %}
  Auction Live Price App Block - Product Handle Specific
{% endcomment %}

<div
  class="auction-price-app-block"
  data-auction-price
  data-auction-handle="{{ product.handle }}"
  data-shop="{{ shop.permanent_domain }}"
  style="display: inline-flex; align-items: center; gap: 10px; margin: 8px 0;"
>
  {% if product.compare_at_price > product.price %}
    <s class="auction-compare-price" style="color: #777; font-size: 1.1em; text-decoration: line-through;">
      {{ product.compare_at_price | money }}
    </s>
  {% else %}
    <s class="auction-compare-price" style="color: #777; font-size: 1.1em; text-decoration: line-through; display: none;">
    </s>
  {% endif %}
  <span class="auction-live-price" style="color: inherit; font-size: 1.4em; font-weight: bold;">
    {{ product.price | money }}
  </span>
</div>

<script>
(function() {
  const API_ENDPOINT = '/api/price';

  function formatGBP(val) {
    const num = Number(val);
    if (!Number.isFinite(num)) return '';
    return '£' + Math.round(num).toLocaleString('en-GB');
  }

  async function checkAndUpdate() {
    const el = document.querySelector('.auction-price-app-block');
    if (!el) return;

    let handle = el.getAttribute('data-auction-handle');
    if (!handle && window.location.pathname.includes('/products/')) {
      handle = window.location.pathname.split('/products/')[1].split('?')[0].split('/')[0];
    }
    const shop = el.getAttribute('data-shop') || window.Shopify?.shop;
    if (!handle || !shop) return;

    try {
      const res = await fetch(`${API_ENDPOINT}?shop=${encodeURIComponent(shop)}&handle=${encodeURIComponent(handle)}&t=${Date.now()}`, {
        method: 'GET',
        cache: 'no-store'
      });
      if (!res.ok) return;

      const data = await res.json();
      const compareTag = el.querySelector('.auction-compare-price');
      const liveTag = el.querySelector('.auction-live-price');

      if (!data || !data.success || data.isAuctionRunning === false) {
        if (compareTag) compareTag.style.setProperty('display', 'none', 'important');
        if (liveTag) {
          liveTag.style.color = 'inherit';
          if (data && data.shopifyPrice) {
            liveTag.textContent = formatGBP(data.shopifyPrice);
          }
        }
        return;
      }

      const livePriceFormatted = formatGBP(data.currentPrice || data.price);
      const openingPriceFormatted = data.openingPrice ? formatGBP(data.openingPrice) : '';

      if (compareTag && openingPriceFormatted && data.openingPrice > (data.currentPrice || data.price)) {
        compareTag.style.setProperty('display', 'inline-block', 'important');
        compareTag.textContent = openingPriceFormatted;
      } else if (compareTag) {
        compareTag.style.setProperty('display', 'none', 'important');
      }

      if (liveTag && livePriceFormatted) {
        liveTag.style.color = '#d82c23';
        liveTag.textContent = livePriceFormatted;
      }
    } catch(e) {
      console.error('[Auction Block Error]', e);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', checkAndUpdate);
  } else {
    checkAndUpdate();
  }

  setInterval(checkAndUpdate, 1500);
})();
</script>

{% schema %}
{
  "name": "Auction Live Price",
  "target": "section",
  "stylesheet": "",
  "javascript": "",
  "settings": []
}
{% endschema %}
